{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneorigin.dev/schemas/bundle/v0.0.1.json",
  "title": "OneOrigin Portable Bundle v0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "createdAt", "items", "manifests"],
  "properties": {
    "schema": { "const": "oneorigin.bundle/v0.0.1" },
    "kind": { "type": "string", "enum": ["skill-pack", "workspace"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "bytes": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "manifests": { "type": "array", "items": { "$ref": "capability-manifest.schema.json" } },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519", "sha256"] },
        "value": { "type": "string" },
        "signer": { "type": "string" }
      }
    }
  }
}
