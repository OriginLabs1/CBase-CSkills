{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneorigin.dev/schemas/oneorigin.template/v0.0.2",
  "title": "OneOrigin Template",
  "type": "object",
  "required": ["schema", "id", "name", "version", "product", "kind", "summary", "files"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "oneorigin.template/v0.0.2" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "product": { "enum": ["corebase", "coreskills"] },
    "kind": { "enum": [
      "workspace", "execution-environment", "policy", "project-foundation",
      "skill", "capability-definition", "instruction", "workflow", "agent-competency"
    ] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 65536 },
    "tags": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/tag" } },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$" },
          "type": { "enum": ["string", "number", "boolean", "json", "file"] },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "mediaType", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
          "bytes": { "type": "string", "contentEncoding": "base64" },
          "sha256": { "$ref": "#/$defs/hashRef" }
        }
      }
    },
    "requires": { "type": "array", "items": { "type": "object" } },
    "permissions": { "type": "array", "items": { "type": "object" } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "products": { "type": "array", "items": { "enum": ["corebase", "coreskills"] } },
        "contractVersions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": { "type": "object" },
    "derivedFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["templateId", "version", "hash"],
        "additionalProperties": false,
        "properties": {
          "templateId": { "$ref": "#/$defs/id" },
          "version": { "type": "string" },
          "hash": { "$ref": "#/$defs/hashRef" }
        }
      }
    },
    "signature": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$" },
    "hashRef": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
